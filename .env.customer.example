# J & J Ozzy Crypto Bot - Customer Settings
# Customers do not need to edit this file by hand.
# First run creates .env automatically. Use the web Settings page after that.

APP_NAME=J & J Ozzy Crypto Bot
APP_ENV=customer
APP_MODE=customer
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
JSON_LOGS=false
DATABASE_URL=sqlite:///./data/trades.db

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_API_WITHDRAWALS_DISABLED_ACK=false

DRY_RUN=true
LIVE_TRADING_ENABLED=false
MANUAL_LIVE_ORDERS_ENABLED=false
AUTO_START_BOT=false
MAX_LIVE_POSITIONS=1
MAX_LIVE_TRADE_VALUE_QUOTE=8.50
MAX_DAILY_LIVE_BUYS=3
MIN_NET_PROFIT_AFTER_FEES_PCT=1.5

DEFAULT_TRADING_PAIR=XBT/USD
DEFAULT_TIMEFRAME=1h
BOT_SCAN_INTERVAL_SECONDS=60
USE_ALL_KRAKEN_PAIRS=true
TRADING_PAIRS=XBT/USD,ETH/USD
ALLOWED_QUOTE_CURRENCIES=USD,AUD
EXCLUDED_PAIRS=AI16Z/USD,AI16Z/AUD,AI16Z/USDT
MAX_PAIRS_PER_CYCLE=0
PAIR_REFRESH_MINUTES=60

PAPER_STARTING_CASH=10000
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_SYMBOL_EXPOSURE=0.20
MAX_TOTAL_EXPOSURE=0.80
FEE_RATE=0.0026
SLIPPAGE_RATE=0.001

STRATEGY_EMA_FAST=9
STRATEGY_EMA_SLOW=21
STRATEGY_RSI_PERIOD=14
STRATEGY_BUY_RSI_THRESHOLD=58
STRATEGY_SELL_RSI_THRESHOLD=42

ENTRY_NO_CHASE_GUARD_ENABLED=true
ENTRY_REQUIRE_PULLBACK_CONFIRMATION=true
ENTRY_BLOCK_RED_CANDLE_BUY=true
# Global entry firewall / collapsed-asset protection
ENTRY_FIREWALL_STRICT=true
ENTRY_REQUIRE_MULTI_TIMEFRAME_CONFIRMATION=true
ENTRY_REQUIRE_1H_UPTREND=true
ENTRY_REQUIRE_15M_RECOVERY=true
ENTRY_BLOCK_FALLING_KNIFE=true
ENTRY_BLOCK_COLLAPSED_ASSETS=true
DISABLE_BUYS_WHEN_EXISTING_RED_BAG=true
DISABLE_AVERAGE_DOWN=true
ENTRY_MAX_BREAK_EVEN_DISTANCE_PCT=4.0
ENTRY_MAX_24H_DROP_PCT=12.0
ENTRY_MAX_7D_DROP_PCT=25.0
# Manual emergency quarantine only. Leave blank for normal global scanning.
SYMBOL_NO_NEW_BUY=
SYMBOL_EXIT_ONLY=

ENTRY_MAX_24H_MOVE_PCT=4.0
ENTRY_LOCAL_HIGH_BLOCK_PCT=0.40
ENTRY_MIN_PULLBACK_FROM_24H_HIGH_PCT=1.25
ENTRY_MAX_3C_MOVE_PCT=0.85
ENTRY_MAX_6C_MOVE_PCT=1.40
ENTRY_MAX_RSI=58
ENTRY_MAX_SPREAD_PCT=0.25
ENTRY_PROFIT_EDGE_GUARD_ENABLED=true
ENTRY_EDGE_BUFFER_PCT=0.50
ENTRY_SPIKE_LOOKBACK_CANDLES=12
ENTRY_BLOCK_AFTER_SPIKE_CANDLES=6
ENTRY_SPIKE_MOVE_PCT=1.25
ENTRY_SPIKE_MIN_PULLBACK_PCT=0.80
ENTRY_MIN_REBOUND_CONFIRMATION_PCT=0.25

LIVE_FEE_FLOOR_PCT=0.80
LIVE_BUY_FEE_FLOOR_PCT=0.80
LIVE_SELL_FEE_FLOOR_PCT=0.80
PROFIT_LOCK_AFTER_SELL_ENABLED=false
PROFIT_LOCK_BUY_PAUSE_MINUTES=0

# Customer builds run paper mode unless live is explicitly enabled by the owner in a later approved build.
CUSTOMER_APPROVAL_SERVER_URL=http://61.69.236.210:8000
HOST=127.0.0.1
PORT=8000
CUSTOMER_EMAIL=
CUSTOMER_NAME=

# Security hardening
CUSTOMER_HEARTBEAT_SHARED_SECRET=
JJOZZY_LOCAL_SESSION_SECRET=
CUSTOMER_UPDATE_MANIFEST_HMAC_KEY=
CUSTOMER_UPDATE_REQUIRE_SIGNED_MANIFEST=true

# Customer updater / admin forced update
JJOZZY_AUTO_UPDATE_ENABLED=true
JJOZZY_UPDATE_REPO=Dirraa/J-J-Ozzy-Crypto-bot-latest
JJOZZY_UPDATE_BRANCH=main
CUSTOMER_UPDATE_DOWNLOAD_URL=
CUSTOMER_UPDATE_GITHUB_TOKEN=
